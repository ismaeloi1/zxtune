<?xml version="1.0" encoding="utf-8" ?>
<!-- Scrubber: bars track with loop marker, 48dp touch height, times at the ends below -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/spacing_half"
        android:paddingRight="@dimen/spacing_half"
        tools:ignore="RtlHardcoded">

    <SeekBar
            android:id="@+id/position_seek"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lhuna_touch_target"
            android:maxHeight="@dimen/lhuna_scrubber_height"
            android:minHeight="@dimen/lhuna_scrubber_height"
            android:paddingLeft="@dimen/lhuna_space_m"
            android:paddingRight="@dimen/lhuna_space_m"
            android:splitTrack="false"
            android:thumb="@drawable/lhuna_scrubber_thumb"
            tools:progress="33" />

    <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/lhuna_space_m"
            android:paddingRight="@dimen/lhuna_space_m">

        <TextView
                android:id="@+id/position_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:text="@string/stub_time"
                android:textAppearance="@style/TextAppearance.Lhuna.Mono.Time" />

        <TextView
                android:id="@+id/position_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:text="@string/stub_time"
                android:textAppearance="@style/TextAppearance.Lhuna.Mono.Time.Secondary" />
    </RelativeLayout>
</LinearLayout>
