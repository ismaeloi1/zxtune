<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="RtlHardcoded">

    <data>

        <variable
                name="entry"
                type="app.zxtune.ui.browser.BreadcrumbsEntry" />
    </data>

    <!-- Source is told by its logo only, icon is set by the adapter to fit the chip -->
    <Button
            style="@style/Button.Breadcrumbs.Touch"
            android:layout_width="wrap_content"
            android:contentDescription="@{entry.title}"
            android:text="@{entry.icon == null ? entry.title : null}"
            tools:text="@tools:sample/cities" />
</layout>
