<?xml version="1.0" encoding="utf-8"?>
<!-- Pages are switched by swipe or by bottom navigation in the thumb zone,
  mini player keeps playback at hand while the now playing page is hidden -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/now_playing"
                android:name="app.zxtune.ui.NowPlayingFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="@string/navigation_now_playing" />

        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/playlist_view"
                android:name="app.zxtune.ui.playlist.PlaylistFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="@string/navigation_playlist" />

        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/browser_view"
                android:name="app.zxtune.ui.browser.BrowserFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="@string/navigation_browser" />
    </androidx.viewpager.widget.ViewPager>

    <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mini_player"
            android:name="app.zxtune.ui.MiniPlayerFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:layout="@layout/mini_player" />

    <include layout="@layout/navigation_bar" />
</LinearLayout>
