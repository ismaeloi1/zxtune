<?xml version="1.0" encoding="utf-8" ?>
<!-- Collapsible now playing information, hidden by default to give the height to the visualizer: one line title,
  one line of chips (chip family, format, subtune, program), stream format and emulation lines -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:ignore="RtlHardcoded">

    <TextView
            android:id="@+id/brief_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingHorizontal="@dimen/lhuna_space_l"
            android:scrollbars="vertical"
            tools:text="Some\nmultiline\ntext\nwith\nmany\nlines" />

    <LinearLayout
            android:id="@+id/brief_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/lhuna_space_l"
            android:paddingRight="@dimen/spacing_half"
            android:paddingBottom="@dimen/spacing_half"
            android:visibility="gone"
            tools:visibility="visible">

        <!-- Tap on title collapses the block back -->
        <LinearLayout
                android:id="@+id/brief_header"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lhuna_touch_target"
                android:background="?selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/brief_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Lhuna.Headline"
                    android:textStyle="bold"
                    tools:text="@tools:sample/lorem/random" />

            <ImageButton
                    android:id="@+id/brief_details_toggle"
                    style="@style/Button.Icon.Toggled"
                    android:contentDescription="@string/track_details"
                    android:src="@drawable/ic_menu_info" />
        </LinearLayout>

        <TextView
                android:id="@+id/brief_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/lhuna_space_m"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="@style/TextAppearance.Lhuna.Body.Secondary"
                android:visibility="gone"
                tools:text="@tools:sample/full_names"
                tools:visibility="visible" />

        <LinearLayout
                android:id="@+id/brief_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/lhuna_space_m"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/brief_chip_family"
                    style="@style/Lhuna.Chip.Small"
                    android:visibility="gone"
                    tools:text="SID"
                    tools:visibility="visible" />

            <TextView
                    android:id="@+id/brief_chip_format"
                    style="@style/Lhuna.Chip.Small"
                    android:visibility="gone"
                    tools:text="PT3"
                    tools:visibility="visible" />

            <TextView
                    android:id="@+id/brief_chip_track"
                    style="@style/Lhuna.Chip.Small"
                    android:visibility="gone"
                    tools:text="#2"
                    tools:visibility="visible" />

            <TextView
                    android:id="@+id/brief_chip_program"
                    style="@style/Lhuna.Chip.Small"
                    android:layout_marginRight="0dp"
                    android:visibility="gone"
                    tools:text="Vortex Tracker II"
                    tools:visibility="visible" />
        </LinearLayout>

        <!-- Stream format or chips emulation, original driver, engine, timing -->
        <TextView
                android:id="@+id/brief_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_half"
                android:layout_marginRight="@dimen/lhuna_space_m"
                android:fontFamily="monospace"
                android:textColor="@color/lhuna_text_2"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="PAL, MOS6581, reSIDfp, resample · out 48 kHz\nOriginal driver: CheeseCutter 2.x\nRunning on NebulaWeave3"
                tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
