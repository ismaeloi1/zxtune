<?xml version="1.0" encoding="utf-8"?>
<!-- Browser row: icon, cover or chip family badge in the same column as playlist badges, title over description,
  size in tabular digits -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="RtlHardcoded">

    <data>

        <import type="android.view.View" />

        <variable
                name="entry"
                type="app.zxtune.ui.browser.ListingEntry" />
    </data>

    <!-- type mark sticks out of the icon corner -->
    <RelativeLayout
            style="@style/ListItem.Lhuna"
            android:clipChildren="false">

        <FrameLayout
                android:id="@+id/browser_entry_icon"
                android:layout_width="@dimen/lhuna_badge_size"
                android:layout_height="@dimen/lhuna_badge_size"
                android:clipChildren="false"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/lhuna_space_xl">

            <ImageView
                    android:id="@+id/browser_entry_main_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:resource="@{entry.getMainIcon()}"
                    tools:src="@sample/browser.json/data/icon" />

            <ImageView
                    android:id="@+id/browser_entry_main_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    tools:src="@sample/browser.json/data/image" />

            <TextView
                    android:id="@+id/browser_entry_badge"
                    style="@style/Lhuna.Badge"
                    android:importantForAccessibility="no"
                    android:visibility="gone"
                    tools:text="SID" />

            <ImageView
                    android:id="@+id/browser_entry_additional_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:resource="@{entry.getAdditionalIcon()}"
                    tools:layout_gravity="@sample/browser.json/data/badge_gravity"
                    tools:src="@sample/browser.json/data/badge" />
        </FrameLayout>

        <TextView
                android:id="@+id/browser_entry_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/spacing_full"
                android:layout_marginRight="@dimen/lhuna_space_xl"
                android:textAppearance="@style/TextAppearance.Lhuna.Mono.Duration"
                app:text="@{entry.details}"
                tools:text="@sample/browser.json/data/details" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/lhuna_space_l"
                android:layout_marginRight="@dimen/spacing_full"
                android:layout_toLeftOf="@id/browser_entry_details"
                android:layout_toRightOf="@id/browser_entry_icon"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@{entry.title}"
                    android:textAppearance="@style/TextAppearance.Lhuna.Title"
                    tools:text="@sample/browser.json/data/title" />

            <TextView
                    android:id="@+id/list_item_text_aux"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Lhuna.Body.Secondary"
                    app:text="@{entry.description}"
                    tools:text="@sample/browser.json/data/subtitle" />
        </LinearLayout>
    </RelativeLayout>
</layout>
