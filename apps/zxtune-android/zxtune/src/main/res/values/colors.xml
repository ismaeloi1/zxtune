<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- LHUNA design tokens: dark-first, one neon accent, tonal surfaces instead of shadows -->
    <color name="lhuna_surface_0">#000000</color>
    <color name="lhuna_surface_1">#0D0E13</color>
    <color name="lhuna_surface_2">#15171F</color>
    <color name="lhuna_surface_3">#1E2130</color>
    <color name="lhuna_outline">#2A2E40</color>
    <color name="lhuna_text_1">#F2F4FA</color>
    <color name="lhuna_text_2">#A6ACC2</color>
    <color name="lhuna_text_3">#767C92</color>
    <!-- 'Signal' cyan: progress, active state, primary action -->
    <color name="lhuna_accent">#00E5FF</color>
    <!-- Tonal background of activated toggles, white content on it stays readable -->
    <color name="lhuna_accent_container">#00404A</color>
    <color name="lhuna_on_accent">#001418</color>
    <!-- 'Lune' violet: secondary marks (loop point, cutoff, resonance) -->
    <color name="lhuna_accent_2">#8A6CFF</color>
    <color name="lhuna_danger">#FF5C6C</color>
    <!-- Notices that need attention but are not errors (e.g. setting applied to next track) -->
    <color name="lhuna_warning">#FFB547</color>
    <!-- Labels and controls of disabled settings, intentionally below text contrast -->
    <color name="lhuna_text_disabled">#4E5366</color>
    <!-- Pressed state of accent filled controls -->
    <color name="lhuna_accent_pressed">#80F2FF</color>
    <!-- Borders of outlined buttons and chips, visible on any surface -->
    <color name="lhuna_outline_strong">#3C4157</color>
    <!-- Current track row: darker than accent_container to keep accent title readable on it -->
    <color name="lhuna_accent_surface">#062A31</color>
    <!-- Per voice colors, shared by oscilloscopes, dashboards and filter curves -->
    <color name="lhuna_voice_1">#FFB547</color>
    <color name="lhuna_voice_2">#5FD38D</color>
    <color name="lhuna_voice_3">#FF6FA5</color>
    <color name="lhuna_voice_4">#6FB8FF</color>
    <color name="lhuna_voice_5">#C59BFF</color>
    <color name="lhuna_voice_6">#D4EE6A</color>
    <color name="lhuna_voice_7">#FF8A5C</color>
    <color name="lhuna_voice_8">#4FD8C8</color>

    <color name="accent">@color/lhuna_accent</color>
    <color name="accent_transparent">#8000E5FF</color>

    <!-- AMOLED black only theme -->
    <color name="background">@android:color/black</color>
</resources>
