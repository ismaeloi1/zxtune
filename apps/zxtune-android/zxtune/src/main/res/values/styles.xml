<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The only theme: dark with pure black backgrounds for AMOLED screens -->
    <style name="CustomTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:dialogTheme">@style/CustomDialog</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
    </style>

    <style name="FullscreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?android:listPreferredItemHeight</item>
        <item name="android:background">@drawable/selectable_background</item>
        <item name="android:foreground">?android:selectableItemBackground</item>
        <item name="android:paddingLeft">?android:listPreferredItemPaddingLeft</item>
        <item name="android:paddingRight">?android:listPreferredItemPaddingRight</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ListItem.Large">
        <item name="android:layout_height">?android:listPreferredItemHeight</item>
        <item name="android:paddingLeft">0px</item>
    </style>

    <style name="Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">32dp</item>
        <item name="tint">?colorControlNormal</item>
    </style>

    <!-- Playback controls without default 48dp minimal height to give more space to visualizer -->
    <style name="Button.Compact">
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">@dimen/spacing_half</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Button.Toggled.Compact">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">@dimen/controls_height</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:padding">@dimen/spacing_half</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Button.Toggled">
        <item name="android:minWidth">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/toggle_button_background</item>
    </style>

    <style name="Button.Breadcrumbs">
        <item name="android:drawableRight">@drawable/breadcrumbs_delimiter</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:padding">1dp</item>
    </style>

    <!-- Primary transport action: filled accent disc, the only element with a strong accent fill -->
    <style name="Button.Play">
        <item name="android:layout_width">@dimen/lhuna_play_size</item>
        <item name="android:layout_height">@dimen/lhuna_play_size</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">@dimen/spacing_full</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/lhuna_play_background</item>
        <item name="tint">@color/lhuna_on_accent</item>
    </style>

    <!-- LHUNA typography: Fredoka (display, Latin) / Nunito (UI) / JetBrains Mono (numbers, registers), all OFL-1.1.
      Glyphs missing in the bundled subsets fall back to system font. -->
    <style name="TextAppearance.Lhuna" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/lhuna_text_1</item>
    </style>

    <style name="TextAppearance.Lhuna.Display">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Headline">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/lhuna_text_2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.Lhuna.Mono">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Mono.Secondary">
        <item name="android:textColor">@color/lhuna_text_2</item>
    </style>

    <style name="CustomDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorAccent">@color/accent</item>
        <!-- strange bug with broken background -->
        <item name="android:background">?android:colorBackground</item>
        <item name="android:windowNoTitle">false</item>
    </style>

    <!-- Live settings panel over oscilloscope: oscilloscope is visible and animated behind it -->
    <style name="ScopeSettingsDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
