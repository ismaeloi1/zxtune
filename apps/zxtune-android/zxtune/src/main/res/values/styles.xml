<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- The only theme: dark with pure black backgrounds for AMOLED screens -->
    <style name="CustomTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:dialogTheme">@style/CustomDialog</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
        <item name="dialogTheme">@style/CustomDialog</item>
        <item name="alertDialogTheme">@style/CustomDialog.Alert</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Lhuna</item>
    </style>

    <!-- Android Auto media template: accent for progress and highlights, the rest is rendered by car host -->
    <style name="CarTheme">
        <item name="colorPrimary">@color/lhuna_surface_1</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@color/lhuna_accent</item>
    </style>

    <!-- Oscilloscope, its live settings panel shows preferences as well -->
    <style name="FullscreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
        <item name="alertDialogTheme">@style/CustomDialog.Alert</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Lhuna</item>
    </style>

    <style name="ListItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?android:listPreferredItemHeight</item>
        <item name="android:background">@drawable/selectable_background</item>
        <item name="android:foreground">?android:selectableItemBackground</item>
        <item name="android:paddingLeft">?android:listPreferredItemPaddingLeft</item>
        <item name="android:paddingRight">?android:listPreferredItemPaddingRight</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ListItem.Large">
        <item name="android:layout_height">?android:listPreferredItemHeight</item>
        <item name="android:paddingLeft">0px</item>
    </style>

    <style name="Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minWidth">32dp</item>
        <item name="tint">?colorControlNormal</item>
    </style>

    <!-- Playback controls without default 48dp minimal height to give more space to visualizer -->
    <style name="Button.Compact">
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">@dimen/spacing_half</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Button.Toggled.Compact">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">@dimen/controls_height</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:padding">@dimen/spacing_half</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="Button.Toggled">
        <item name="android:minWidth">48dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/toggle_button_background</item>
    </style>

    <style name="Button.Breadcrumbs">
        <item name="android:drawableRight">@drawable/breadcrumbs_delimiter</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:padding">1dp</item>
    </style>

    <!-- Primary transport action: filled accent disc, the only element with a strong accent fill -->
    <style name="Button.Play">
        <item name="android:layout_width">@dimen/lhuna_play_size</item>
        <item name="android:layout_height">@dimen/lhuna_play_size</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:padding">@dimen/spacing_full</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/lhuna_play_background</item>
        <item name="tint">@color/lhuna_on_accent</item>
    </style>

    <!-- LHUNA typography: system font only, hierarchy is made by sizes, weights and colors -->
    <style name="TextAppearance.Lhuna" parent="TextAppearance.AppCompat">
        <item name="android:textColor">@color/lhuna_text_1</item>
    </style>

    <style name="TextAppearance.Lhuna.Display">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Headline">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Title">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Label">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/lhuna_text_2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="TextAppearance.Lhuna.Mono">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Lhuna.Mono.Secondary">
        <item name="android:textColor">@color/lhuna_text_2</item>
    </style>

    <!-- Dialogs: tonal surface with r28 corners, pill buttons. Dialog fragments are turned into bottom sheets by
      app.zxtune.ui.utils.DialogSheets -->
    <style name="CustomDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/lhuna_dialog_background</item>
        <item name="android:colorBackground">@color/lhuna_surface_1</item>
        <item name="android:textColorPrimary">@color/lhuna_text_1</item>
        <item name="android:textColorSecondary">@color/lhuna_text_2</item>
        <item name="android:windowTitleStyle">@style/Lhuna.DialogWindowTitle</item>
        <item name="android:windowNoTitle">false</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Lhuna.Button.Pill.Filled.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Lhuna.Button.Pill.Outlined.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Lhuna.Button.Pill.Text.Dialog</item>
    </style>

    <style name="CustomDialog.Alert" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/lhuna_dialog_background</item>
        <item name="android:colorBackground">@color/lhuna_surface_1</item>
        <item name="android:textColorPrimary">@color/lhuna_text_1</item>
        <item name="android:textColorSecondary">@color/lhuna_text_2</item>
        <item name="android:windowTitleStyle">@style/Lhuna.DialogWindowTitle</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Lhuna.Button.Pill.Filled.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Lhuna.Button.Pill.Outlined.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Lhuna.Button.Pill.Text.Dialog</item>
    </style>

    <!-- Screen sized dialog (About): pure black like the main screen -->
    <style name="CustomDialog.Fullscreen" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/lhuna_surface_0</item>
        <item name="android:colorBackground">@color/lhuna_surface_0</item>
        <item name="android:windowAnimationStyle">@style/Animation.Lhuna.Sheet</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/lhuna_accent</item>
    </style>

    <style name="Lhuna.DialogWindowTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:textAppearance">@style/TextAppearance.Lhuna.Headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Animation.Lhuna.Sheet" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/lhuna_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/lhuna_sheet_exit</item>
    </style>

    <!-- Pill buttons: filled for the primary action, outlined for secondary, text for tertiary -->
    <style name="Lhuna.Button.Pill" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">@dimen/lhuna_pill_height</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">@dimen/lhuna_space_xl</item>
        <item name="android:paddingRight">@dimen/lhuna_space_xl</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator" tools:targetApi="21">@null</item>
        <item name="android:elevation" tools:targetApi="21">0dp</item>
    </style>

    <style name="Lhuna.Button.Pill.Filled">
        <item name="android:background">@drawable/lhuna_pill_filled</item>
        <item name="android:textColor">@color/lhuna_pill_filled_text</item>
    </style>

    <style name="Lhuna.Button.Pill.Outlined">
        <item name="android:background">@drawable/lhuna_pill_outlined</item>
        <item name="android:textColor">@color/lhuna_pill_outlined_text</item>
    </style>

    <style name="Lhuna.Button.Pill.Text">
        <item name="android:background">@drawable/lhuna_pill_text</item>
        <item name="android:textColor">@color/lhuna_pill_outlined_text</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingLeft">@dimen/lhuna_space_l</item>
        <item name="android:paddingRight">@dimen/lhuna_space_l</item>
    </style>

    <!-- Dialog buttons: vertical spacing is the part of background, see lhuna_pill_*_dialog -->
    <style name="Lhuna.Button.Pill.Filled.Dialog">
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/lhuna_pill_filled_dialog</item>
        <item name="android:layout_marginLeft">@dimen/lhuna_space_s</item>
    </style>

    <style name="Lhuna.Button.Pill.Outlined.Dialog">
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/lhuna_pill_outlined_dialog</item>
        <item name="android:layout_marginLeft">@dimen/lhuna_space_s</item>
    </style>

    <style name="Lhuna.Button.Pill.Text.Dialog">
        <item name="android:minHeight">64dp</item>
        <item name="android:background">@drawable/lhuna_pill_text_dialog</item>
    </style>

    <!-- Section label of About page -->
    <style name="Lhuna.About.Section" parent="Lhuna.Settings.Header">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">@dimen/spacing_half</item>
        <item name="android:paddingTop">@dimen/lhuna_space_xl</item>
        <item name="android:paddingBottom">@dimen/lhuna_space_s</item>
        <item name="android:textColor">@color/lhuna_text_2</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
    </style>

    <!-- Circular tonal icon button: back, close -->
    <style name="Lhuna.RoundButton">
        <item name="android:layout_width">@dimen/lhuna_round_button</item>
        <item name="android:layout_height">@dimen/lhuna_round_button</item>
        <item name="android:background">@drawable/lhuna_round_button</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/lhuna_text_1</item>
    </style>

    <!-- namespaces of LHUNA component styles -->
    <style name="Lhuna" />

    <style name="Lhuna.Settings" />

    <!-- Settings: grouped cards (see app.zxtune.ui.settings.SettingsCards), section headers, rows with control at end -->
    <style name="Lhuna.Settings.Header">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/lhuna_accent</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing" tools:targetApi="21">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Lhuna.Settings.Title">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/lhuna_pref_title</item>
        <item name="android:hyphenationFrequency" tools:targetApi="23">normal</item>
        <item name="android:breakStrategy" tools:targetApi="23">balanced</item>
    </style>

    <style name="Lhuna.Settings.Summary">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lhuna_pref_summary</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:maxLines">10</item>
        <item name="android:ellipsize">end</item>
        <item name="android:hyphenationFrequency" tools:targetApi="23">normal</item>
    </style>

    <!-- Current value of slider with unit, tabular digits don't jump while dragging -->
    <style name="Lhuna.Settings.Value">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/lhuna_pref_value</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings" tools:targetApi="21">tnum</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">right</item>
    </style>

    <style name="Lhuna.Settings.Segment">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/lhuna_segment_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Lhuna.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/lhuna_popup_background</item>
        <item name="android:dropDownVerticalOffset">0dp</item>
    </style>

    <style name="Lhuna.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/lhuna_seekbar_track</item>
        <item name="android:thumb">@drawable/lhuna_seekbar_thumb</item>
        <item name="android:minHeight">4dp</item>
        <item name="android:maxHeight">4dp</item>
        <!-- with the rest of the row gives 48dp touch target, track is aligned with texts while the thumb overhangs -->
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:layout_marginLeft">-10dp</item>
        <item name="android:layout_marginRight">-10dp</item>
        <item name="android:splitTrack" tools:targetApi="21">false</item>
        <item name="android:background">@null</item>
    </style>

    <style name="Lhuna.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/lhuna_switch_thumb</item>
        <item name="track">@drawable/lhuna_switch_track</item>
        <item name="switchMinWidth">56dp</item>
        <item name="showText">false</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <style name="PreferenceThemeOverlay.Lhuna" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/Preference.Lhuna</item>
        <item name="preferenceScreenStyle">@style/Preference.Lhuna</item>
        <item name="preferenceCategoryStyle">@style/Preference.Lhuna.Category</item>
        <item name="switchPreferenceCompatStyle">@style/Preference.Lhuna.Switch</item>
        <item name="seekBarPreferenceStyle">@style/Preference.Lhuna.SeekBar</item>
        <item name="dropdownPreferenceStyle">@style/Preference.Lhuna.DropDown</item>
        <item name="preferenceFragmentCompatStyle">@style/PreferenceFragment.Lhuna</item>
        <item name="preferenceFragmentListStyle">@style/PreferenceFragmentList.Lhuna</item>
    </style>

    <style name="Preference.Lhuna" parent="Preference.Material">
        <item name="android:layout">@layout/lhuna_preference</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Preference.Lhuna.Category" parent="Preference.Category.Material">
        <item name="android:layout">@layout/lhuna_preference_category</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.Lhuna.Switch" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="android:layout">@layout/lhuna_preference</item>
        <item name="android:widgetLayout">@layout/lhuna_preference_widget_switch</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="Preference.Lhuna.SeekBar" parent="Preference.SeekBarPreference.Material">
        <item name="android:layout">@layout/lhuna_preference_seekbar</item>
        <item name="showSeekBarValue">true</item>
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="Preference.Lhuna.DropDown" parent="Preference.DropDown.Material">
        <item name="android:layout">@layout/lhuna_preference_dropdown</item>
        <item name="iconSpaceReserved">false</item>
        <item name="singleLineTitle">false</item>
    </style>

    <style name="PreferenceFragment.Lhuna" parent="PreferenceFragment.Material">
        <item name="android:divider">@null</item>
        <item name="allowDividerAfterLastItem">false</item>
    </style>

    <style name="PreferenceFragmentList.Lhuna" parent="PreferenceFragmentList.Material">
        <item name="android:paddingBottom">@dimen/lhuna_space_xl</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Live settings panel over oscilloscope: oscilloscope is visible and animated behind it -->
    <style name="ScopeSettingsDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
