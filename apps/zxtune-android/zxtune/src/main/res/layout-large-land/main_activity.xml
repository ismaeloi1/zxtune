<?xml version="1.0" encoding="utf-8"?>
<!-- Now playing is always visible on the left, so neither its page nor the mini player is needed:
  navigation switches the lists on the right only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

    <androidx.fragment.app.FragmentContainerView
            android:id="@+id/now_playing"
            android:name="app.zxtune.ui.NowPlayingFragment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/lhuna_outline" />

    <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

        <androidx.viewpager.widget.ViewPager
                android:id="@+id/view_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/playlist_view"
                    android:name="app.zxtune.ui.playlist.PlaylistFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="@string/navigation_playlist" />

            <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/browser_view"
                    android:name="app.zxtune.ui.browser.BrowserFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:tag="@string/navigation_browser" />
        </androidx.viewpager.widget.ViewPager>

        <LinearLayout
                android:id="@+id/navigation_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lhuna_compact_nav_height"
                android:background="@color/lhuna_surface_1"
                android:orientation="horizontal">

            <include layout="@layout/navigation_bar_lists" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
