<?xml version="1.0" encoding="utf-8"?>
<!-- Pill track: filled accent when on, outlined tonal when off (shape is never told by color only) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/lhuna_accent_container" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/lhuna_accent" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/lhuna_surface_2" />
            <stroke android:width="2dp" android:color="@color/lhuna_surface_3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="56dp" android:height="28dp" />
            <corners android:radius="14dp" />
            <solid android:color="@color/lhuna_surface_3" />
            <stroke android:width="2dp" android:color="@color/lhuna_text_3" />
        </shape>
    </item>
</selector>
