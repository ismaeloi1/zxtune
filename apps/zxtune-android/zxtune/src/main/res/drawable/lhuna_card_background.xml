<?xml version="1.0" encoding="utf-8"?>
<!-- Source card: tonal surface instead of shadow, outlined when selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_l" />
            <solid android:color="@color/lhuna_surface_3" />
            <stroke
                    android:width="1.5dp"
                    android:color="@color/lhuna_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_l" />
            <solid android:color="@color/lhuna_surface_1" />
            <stroke
                    android:width="1dp"
                    android:color="@color/lhuna_outline" />
        </shape>
    </item>
</selector>
