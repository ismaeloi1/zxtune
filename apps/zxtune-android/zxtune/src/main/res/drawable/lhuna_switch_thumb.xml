<?xml version="1.0" encoding="utf-8"?>
<!-- 20dp disc inside 28dp box: insets are not paddings, so SwitchCompat keeps the disc inside the track -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_enabled="false">
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="@color/lhuna_text_3" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="@color/lhuna_on_accent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="@color/lhuna_text_disabled" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="oval">
                    <size android:width="20dp" android:height="20dp" />
                    <solid android:color="@color/lhuna_text_2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
