<?xml version="1.0" encoding="utf-8"?>
<!-- List row states as inset tonal cards: selected (multiselection) and dragged -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset
                android:insetLeft="@dimen/spacing_full"
                android:insetRight="@dimen/spacing_full"
                android:insetTop="2dp"
                android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/lhuna_radius_l" />
                <solid android:color="@color/lhuna_surface_3" />
            </shape>
        </inset>
    </item>
    <item android:state_activated="true">
        <inset
                android:insetLeft="@dimen/spacing_full"
                android:insetRight="@dimen/spacing_full"
                android:insetTop="2dp"
                android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/lhuna_radius_l" />
                <solid android:color="@color/lhuna_surface_2" />
                <stroke
                        android:width="1dp"
                        android:color="@color/lhuna_outline" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
