<?xml version="1.0" encoding="utf-8"?>
<!-- Breadcrumb chip, the current location is outlined -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_xl" />
            <solid android:color="@color/lhuna_surface_3" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_xl" />
            <solid android:color="@color/lhuna_surface_2" />
        </shape>
    </item>
</selector>
