<?xml version="1.0" encoding="utf-8"?>
<!-- Breadcrumb chip, the current location is outlined. Chip is inset in touch target of its button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <inset
            android:insetTop="@dimen/lhuna_crumb_inset"
            android:insetBottom="@dimen/lhuna_crumb_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/lhuna_radius_xl" />
                <solid android:color="@color/lhuna_surface_3" />
            </shape>
        </inset>
    </item>
    <item>
        <inset
            android:insetTop="@dimen/lhuna_crumb_inset"
            android:insetBottom="@dimen/lhuna_crumb_inset">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/lhuna_radius_xl" />
                <solid android:color="@color/lhuna_surface_2" />
            </shape>
        </inset>
    </item>
</selector>
