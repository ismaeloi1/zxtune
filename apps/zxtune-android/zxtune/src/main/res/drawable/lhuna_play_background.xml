<?xml version="1.0" encoding="utf-8"?>
<!-- Primary transport action: accent disc, muted while there is nothing to play -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/lhuna_surface_3" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/lhuna_text_1" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lhuna_accent" />
        </shape>
    </item>
</selector>
