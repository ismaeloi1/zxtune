<?xml version="1.0" encoding="utf-8"?>
<!-- Current track row: tonal accent card, outlined when the row is also selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_l" />
            <solid android:color="@color/lhuna_accent_surface" />
            <stroke
                    android:width="1.5dp"
                    android:color="@color/lhuna_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/lhuna_radius_l" />
            <solid android:color="@color/lhuna_accent_surface" />
        </shape>
    </item>
</selector>
