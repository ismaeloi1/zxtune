<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action: filled accent pill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/lhuna_surface_3" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/lhuna_accent_pressed" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/lhuna_accent" />
            <stroke android:width="2dp" android:color="@color/lhuna_text_1" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/lhuna_accent" />
        </shape>
    </item>
</selector>
